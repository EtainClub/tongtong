{
  "name": "tongtong",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-tongtong \"vitest run tests --no-file-parallelism\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-tongtong",
    "dev:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-tongtong GCLOUD_PROJECT=demo-tongtong FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 next dev",
    "validate": "tsx scripts/validate-content.ts",
    "review": "tsx scripts/review-checklist.ts",
    "metrics": "GOOGLE_CLOUD_PROJECT=tongtongs tsx scripts/metrics.ts",
    "check": "pnpm validate && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^9.15.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.17.1"
}
